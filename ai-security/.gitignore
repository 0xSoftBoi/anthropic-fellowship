# Secrets
.env
.env.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Fetched contract source caches (re-fetchable via benchmarks/fetch_contracts.py)
benchmarks/_cache/
*.solc-cache

# Sanitized corpora — derived artifacts, regenerate with:
#   python -m benchmarks.sanitize --write
# (benchmarks/leakage_report.json IS committed: it is the measurement, not the output.)
benchmarks/contracts_stripped/
benchmarks/contracts_anon/

# Note: results_*.json are committed on purpose (auditable benchmark artifacts).

# Remeasure-run artifacts — generated by `python -m agents.remeasure`
# (preflight writes benchmarks/remeasure_preflight.json; paid runs write
# results_remeasure/). Uploaded as CI artifacts, never committed.
benchmarks/remeasure_preflight.json
results_remeasure/
